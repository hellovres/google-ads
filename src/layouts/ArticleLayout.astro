---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PhraseList from '../components/PhraseList.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCategoryFor, getRelatedArticles, articlePath, type ArticleEntry } from '../lib/articles';
import { formatDate, site } from '../lib/site';

interface Props {
  article: ArticleEntry;
  headings: { depth: number; slug: string; text: string }[];
}

const { article, headings } = Astro.props;
const category = getCategoryFor(article);
const related = await getRelatedArticles(article);
const canonical = new URL(articlePath(article), site.url);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const phrases = article.data.phrases ?? category.phrases;
const published = article.data.pubDate;
const modified = article.data.updatedDate ?? article.data.pubDate;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  image: [new URL(article.data.heroImage, site.url).toString()],
  datePublished: published.toISOString(),
  dateModified: modified.toISOString(),
  author: { '@type': 'Organization', name: site.name, url: site.url },
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
  mainEntityOfPage: canonical.toString(),
  articleSection: category.name,
  keywords: article.data.keywords.join(', '),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: category.name, item: new URL(`/${category.slug}/`, site.url).toString() },
    { '@type': 'ListItem', position: 3, name: article.data.title, item: canonical.toString() },
  ],
};

const faqJsonLd = article.data.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: article.data.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : undefined;

const jsonLd = faqJsonLd ? [articleJsonLd, breadcrumbJsonLd, faqJsonLd] : [articleJsonLd, breadcrumbJsonLd];
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  image={article.data.heroImage}
  type="article"
  publishedTime={published}
  modifiedTime={modified}
  jsonLd={jsonLd}
>
  <article>
    <header class="article-header">
      <div class="wrap">
        <Breadcrumbs items={[
          { label: 'Home', href: '/' },
          { label: category.name, href: `/${category.slug}/` },
          { label: article.data.title },
        ]} />
        <h1 class="display article-title">{article.data.title}</h1>
        <p class="article-deck">{article.data.description}</p>
        <div class="article-meta">
          <span class="category-pill">{category.name}</span>
          <span>Updated {formatDate(modified)}</span>
          <span>{article.data.readingTime} min read</span>
          <span>Field guide</span>
        </div>
      </div>

      <div class="wrap">
        <figure class="article-hero">
          <img src={article.data.heroImage} alt={article.data.heroAlt} width="1600" height="760" fetchpriority="high" />
          <figcaption>{article.data.heroAlt} · Original illustration for {site.name}</figcaption>
        </figure>
      </div>
    </header>

    <div class="wrap article-shell">
      {toc.length > 0 && (
        <aside class="toc" aria-label="On this page">
          <strong>On this page</strong>
          <ol>
            {toc.map((heading) => (
              <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </aside>
      )}

      <div>
        {article.data.quickFacts.length > 0 && (
          <dl class="quick-facts">
            {article.data.quickFacts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )}

        {toc.length > 0 && (
          <details class="toc-mobile">
            <summary>On this page</summary>
            <ol>
              {toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
            </ol>
          </details>
        )}

        <div class="prose" style="margin-top: 38px;">
          <slot />
        </div>

        <div class="affiliate-note">
          <span aria-hidden="true">↗</span>
          <div>
            <strong>Booking links</strong>
            Some guides may include affiliate links to hotels, tours or eSIM providers. They cost you nothing extra and never change the route advice. <a href="/affiliate-disclosure/">Read the disclosure</a>.
          </div>
        </div>

        <section class="article-block" id="phrases">
          <span class="eyebrow" style="color: var(--terra); margin-bottom: 14px;">What to say</span>
          <h2>Five phrases for this stop</h2>
          <PhraseList phrases={phrases} />
        </section>

        {article.data.photoSpots.length > 0 && (
          <section class="article-block">
            <span class="eyebrow" style="color: var(--terra); margin-bottom: 14px;">Camera</span>
            <h2>Photo spots that work</h2>
            <div class="photo-grid">
              {article.data.photoSpots.map((spot) => (
                <div class="photo-spot">
                  <strong>{spot.name}</strong>
                  <span>{spot.note}</span>
                </div>
              ))}
            </div>
          </section>
        )}

        {article.data.faq.length > 0 && (
          <section class="article-block">
            <span class="eyebrow" style="color: var(--terra); margin-bottom: 14px;">Quick answers</span>
            <h2>FAQ</h2>
            <div class="faq-list">
              {article.data.faq.map((item) => (
                <details class="faq-item">
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section-tight section-rule">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow" style="color: var(--terra);">Keep going</span>
            <h2 style="margin-top: 16px;">More from {category.name}</h2>
          </div>
          <a class="text-link" href={`/${category.slug}/`}>All {category.shortName.toLowerCase()} guides <span aria-hidden="true">→</span></a>
        </div>
        <div class="card-grid">
          {related.map((item) => <ArticleCard article={item} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script is:inline>
  const links = Array.from(document.querySelectorAll('.toc a'));
  const headings = links
    .map((link) => document.querySelector(link.getAttribute('href')))
    .filter(Boolean);
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      links.forEach((link) => link.classList.toggle('is-active', link.getAttribute('href') === '#' + entry.target.id));
    }
  }, { rootMargin: '-15% 0px -70% 0px' });
  headings.forEach((heading) => observer.observe(heading));
</script>
