---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CityMap from '../components/CityMap.astro';
import PhraseList from '../components/PhraseList.astro';
import { getAllArticles, getFeaturedArticles, articlePath } from '../lib/articles';
import { categories, categoryOrder } from '../lib/categories';
import { site } from '../lib/site';

const all = await getAllArticles();
const featured = await getFeaturedArticles(3);
const storyLead =
  all.find((article) => article.id === 'first-time-chongqing-guide') ?? featured[0] ?? all[0];
const storySide = [
  all.find((article) => article.id === 'chongqing-hotpot-ordering'),
  all.find((article) => article.id === 'where-to-stay-chongqing'),
].filter((article) => article !== undefined);
const latest = all
  .filter((article) => article.id !== storyLead?.id && !storySide.some((item) => item.id === article.id))
  .slice(0, 3);

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
  inLanguage: 'en',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${site.url}/search/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  email: site.email,
  description: site.description,
};
---

<BaseLayout
  title={site.name}
  description={site.description}
  image="/images/og-cover.svg"
  jsonLd={[websiteJsonLd, organizationJsonLd]}
>
  <section class="atlas-hero">
    <div class="atlas-contours" aria-hidden="true"></div>
    <div class="wrap">
      <div class="atlas-heading">
        <div>
          <span class="eyebrow">Chongqing, China · 29.56°N 106.55°E</span>
          <h1 class="display">Read the city <em>by its rivers.</em></h1>
        </div>
        <div class="atlas-deck">
          <p>
            Start with the map. Chongqing makes sense in layers: river bends, vertical streets, monorails disappearing into buildings and the next bowl of noodles.
          </p>
          <div class="atlas-actions">
            <a class="btn is-cream" href={storyLead ? articlePath(storyLead) : '/guides/'}>
              Start with the first-visit guide <span aria-hidden="true">→</span>
            </a>
            <a class="atlas-text-link" href="/attractions/">Browse landmark notes <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>

      <CityMap />

      <div class="atlas-meta">
        <div><strong>08</strong><span>Mapped landmarks</span></div>
        <div><strong>03</strong><span>Ways into the map</span></div>
        <div><strong>05</strong><span>Phrases per stop</span></div>
        <div><strong>2026</strong><span>Practical details</span></div>
      </div>
    </div>
  </section>

  <section class="section story-section">
    <div class="wrap">
      <div class="section-head story-heading">
        <div>
          <span class="eyebrow" style="color: var(--terra);">The essential three</span>
          <h2>One city. One meal. One place to stay.</h2>
        </div>
        <p>These are the three starting points that make the rest of the map easier to choose from.</p>
      </div>

      <div class="story-layout">
        <a class="story-lead" href={articlePath(storyLead)}>
          <img
            src={storyLead.data.heroImage}
            alt={storyLead.data.heroAlt}
            width="900"
            height="660"
            loading="eager"
            decoding="async"
          />
          <span class="story-lead__shade" aria-hidden="true"></span>
          <div class="story-lead__copy">
            <span class="story-lead__kicker">Start here · First visit</span>
            <h3>{storyLead.data.title}</h3>
            <p>{storyLead.data.description}</p>
            <span class="story-lead__link">Open the first-visit guide <span aria-hidden="true">↗</span></span>
          </div>
        </a>

        <div class="story-side">
          <div class="story-side__intro">
            <span>Build the essential picture</span>
            <p>Get the shape of the city first, learn what to order, then choose the right base for the rest of the trip.</p>
          </div>

          {storySide.map((article, index) => (
            <a class="story-row" href={articlePath(article)}>
              <span class="story-row__number">{String(index + 2).padStart(2, '0')}</span>
              <img src={article.data.heroImage} alt="" width="240" height="180" loading="lazy" decoding="async" />
              <span class="story-row__copy">
                <small>{categories[article.data.category].shortName}</small>
                <strong>{article.data.title}</strong>
                <span>{article.data.description}</span>
              </span>
              <span class="story-row__arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section-rule field-section">
    <div class="wrap">
      <div class="field-intro">
        <div>
          <span class="eyebrow" style="color: var(--terra);">Read the map legend</span>
          <h2>Choose by the question in front of you.</h2>
        </div>
        <p>Planning, seeing, eating, moving or sorting out the practical details. Each collection is built around a decision you need to make.</p>
      </div>

      <nav class="field-index" aria-label="Guide categories">
        {categoryOrder.map((slug, index) => {
          const category = categories[slug];
          return (
            <a class="field-index__row" href={`/${category.slug}/`}>
              <span class="field-index__number">{String(index + 1).padStart(2, '0')}</span>
              <span class="field-index__title">
                <small>{category.eyebrow}</small>
                <strong>{category.name}</strong>
              </span>
              <img src={category.art} alt="" width="120" height="92" loading="lazy" aria-hidden="true" />
              <span class="field-index__desc">{category.description}</span>
              <span class="field-index__arrow" aria-hidden="true">→</span>
            </a>
          );
        })}
      </nav>
    </div>
  </section>

  <section class="section latest-section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow" style="color: var(--terra);">Latest field notes</span>
          <h2>New observations from the city.</h2>
        </div>
        <a class="text-link" href="/guides/">All guides <span aria-hidden="true">→</span></a>
      </div>
      <div class="latest-grid">
        {latest.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>

  <section class="section section-rule phrase-section">
    <div class="wrap phrase-panel">
      <div class="phrase-intro">
        <span class="eyebrow" style="color: var(--terra);">Five phrases for the next pin</span>
        <h2>The map opens differently in Mandarin.</h2>
        <p>These phrases cover the moment you are standing at a counter, a queue or a taxi window, phone in hand.</p>
        <a class="btn is-light" style="margin-top: 26px;" href="/practical/sichuanese-phrases/">
          Learn the phrasebook <span aria-hidden="true">→</span>
        </a>
      </div>
      <PhraseList phrases={categories.guides.phrases} />
    </div>
  </section>
</BaseLayout>

<style>
  .atlas-hero {
    position: relative;
    overflow: hidden;
    padding: 54px 0 42px;
    border-radius: 0 0 38px 38px;
    background:
      radial-gradient(circle at 12% 10%, rgba(210, 166, 76, 0.16), transparent 30rem),
      radial-gradient(circle at 88% 22%, rgba(39, 99, 84, 0.2), transparent 34rem),
      var(--ink);
    color: var(--cream);
  }

  .atlas-contours {
    position: absolute;
    inset: -25% -5% auto -5%;
    height: 62%;
    opacity: 0.16;
    background:
      repeating-radial-gradient(ellipse at 13% 15%, transparent 0 35px, rgba(251, 247, 238, 0.26) 36px 37px, transparent 38px 65px),
      repeating-radial-gradient(ellipse at 86% 4%, transparent 0 29px, rgba(251, 247, 238, 0.2) 30px 31px, transparent 32px 55px);
    transform: rotate(-3deg);
    pointer-events: none;
  }

  .atlas-hero .wrap { position: relative; z-index: 2; }

  .atlas-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(310px, 0.65fr);
    gap: 48px;
    align-items: end;
    margin-bottom: 32px;
  }

  .atlas-heading .eyebrow { color: var(--gold); }

  .atlas-heading h1 {
    max-width: 820px;
    margin: 19px 0 0;
    color: var(--cream);
    font-size: clamp(4.2rem, 8.7vw, 8.1rem);
    line-height: 0.9;
  }

  .atlas-heading h1 em {
    color: var(--gold);
    font-style: italic;
  }

  .atlas-deck {
    padding: 0 0 8px 24px;
    border-left: 1px solid rgba(251, 247, 238, 0.23);
  }

  .atlas-deck p {
    max-width: 440px;
    color: rgba(251, 247, 238, 0.7);
    font-size: 0.96rem;
    line-height: 1.65;
  }

  .atlas-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-top: 22px;
  }

  .atlas-text-link {
    color: var(--cream);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid rgba(251, 247, 238, 0.35);
    padding-bottom: 3px;
  }

  .atlas-text-link:hover { color: var(--gold); border-color: var(--gold); }

  .atlas-meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 26px;
    border-top: 1px solid rgba(251, 247, 238, 0.17);
  }

  .atlas-meta div {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 17px 18px 0 0;
  }

  .atlas-meta strong {
    color: var(--gold);
    font-family: var(--serif);
    font-size: 1.55rem;
    font-weight: 400;
  }

  .atlas-meta span {
    color: rgba(251, 247, 238, 0.5);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .story-section { padding-bottom: 104px; }

  .story-heading h2 { max-width: 820px; }

  .story-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.13fr) minmax(360px, 0.87fr);
    gap: 24px;
    align-items: stretch;
  }

  .story-lead {
    position: relative;
    min-height: 660px;
    overflow: hidden;
    border-radius: 26px;
    background: var(--ink);
    color: var(--cream);
    text-decoration: none;
  }

  .story-lead img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 650ms cubic-bezier(.2,.65,.3,1);
  }

  .story-lead:hover img { transform: scale(1.035); }

  .story-lead__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 16%, rgba(10, 21, 16, 0.08) 34%, rgba(10, 21, 16, 0.48) 52%, rgba(10, 21, 16, 0.88) 69%, rgba(10, 21, 16, 0.98) 100%);
  }

  .story-lead__copy {
    position: absolute;
    inset: auto 0 0;
    padding: 34px;
  }

  .story-lead__kicker {
    color: var(--gold);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .story-lead h3 {
    max-width: 680px;
    margin-top: 12px;
    font-family: var(--serif);
    font-size: clamp(2.6rem, 4.3vw, 4.25rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  .story-lead p {
    max-width: 590px;
    margin-top: 16px;
    color: rgba(251, 247, 238, 0.7);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .story-lead__link {
    display: inline-flex;
    gap: 9px;
    margin-top: 22px;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(251, 247, 238, 0.4);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .story-side {
    display: grid;
    align-content: stretch;
    border-top: 1px solid var(--ink);
  }

  .story-side__intro {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 24px;
    padding: 18px 0 22px;
    border-bottom: 1px solid var(--line-strong);
  }

  .story-side__intro > span {
    color: var(--terra);
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .story-side__intro p {
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .story-row {
    display: grid;
    grid-template-columns: 28px 108px minmax(0, 1fr) 18px;
    gap: 15px;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .story-row__number {
    align-self: start;
    padding-top: 3px;
    color: var(--terra);
    font-family: var(--serif);
    font-size: 1rem;
  }

  .story-row img {
    width: 108px;
    height: 108px;
    border-radius: 13px;
    object-fit: cover;
  }

  .story-row__copy { display: grid; }

  .story-row__copy small {
    color: var(--muted);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .story-row__copy strong {
    margin-top: 5px;
    font-family: var(--serif);
    font-size: 1.48rem;
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.06;
  }

  .story-row__copy > span {
    margin-top: 7px;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.48;
  }

  .story-row__arrow {
    color: var(--terra);
    transition: transform 180ms ease;
  }

  .story-row:hover .story-row__copy strong { color: var(--terra); }
  .story-row:hover .story-row__arrow { transform: translate(3px, -3px); }

  .field-section { padding-block: 94px 106px; }

  .field-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.55fr);
    gap: 60px;
    align-items: end;
    margin-bottom: 34px;
  }

  .field-intro h2 {
    max-width: 780px;
    margin-top: 16px;
    font-family: var(--serif);
    font-size: clamp(2.5rem, 5vw, 4.4rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  .field-intro > p {
    color: var(--muted);
    font-size: 0.91rem;
  }

  .field-index { border-top: 1px solid var(--ink); }

  .field-index__row {
    display: grid;
    grid-template-columns: 48px 235px 108px minmax(0, 1fr) 24px;
    gap: 20px;
    align-items: center;
    padding: 16px 4px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: padding 180ms ease, background 180ms ease;
  }

  .field-index__row:hover {
    padding-inline: 16px;
    background: rgba(251, 247, 238, 0.66);
  }

  .field-index__number {
    color: var(--terra);
    font-family: var(--serif);
    font-size: 1.18rem;
  }

  .field-index__title { display: grid; }
  .field-index__title small {
    color: var(--muted);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .field-index__title strong {
    margin-top: 4px;
    font-family: var(--serif);
    font-size: 1.48rem;
    font-weight: 400;
    line-height: 1.05;
  }

  .field-index__row img {
    width: 108px;
    height: 76px;
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: transform 180ms ease;
  }

  .field-index__row:hover img { transform: rotate(-2deg) scale(1.04); }

  .field-index__desc {
    color: var(--muted);
    font-size: 0.74rem;
    line-height: 1.48;
  }

  .field-index__arrow {
    color: var(--terra);
    font-size: 1.05rem;
    transition: transform 180ms ease;
  }

  .field-index__row:hover .field-index__arrow { transform: translateX(4px); }

  .latest-section { padding-block: 104px; }

  .latest-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.9fr 0.9fr;
    gap: 20px;
    align-items: stretch;
  }

  .latest-grid > :global(.article-card:first-child) {
    min-height: 540px;
  }

  .latest-grid > :global(.article-card:first-child .card-media) {
    flex: 1;
    aspect-ratio: auto;
    min-height: 340px;
  }

  .latest-grid > :global(.article-card:first-child .card-title) {
    font-size: clamp(2rem, 3.3vw, 3rem);
  }

  .phrase-section { padding-block: 80px 100px; }

  @media (max-width: 1060px) {
    .atlas-heading { grid-template-columns: 1fr; gap: 24px; }
    .atlas-deck { max-width: 740px; padding-left: 0; border-left: 0; }
    .story-layout { grid-template-columns: 1fr; }
    .story-lead { min-height: 570px; }
    .story-side__intro { grid-template-columns: 1fr 1.4fr; }
    .field-index__row { grid-template-columns: 42px 210px minmax(0, 1fr) 22px; }
    .field-index__row img { display: none; }
  }

  @media (max-width: 860px) {
    .atlas-hero { padding-top: 42px; }
    .atlas-heading h1 { font-size: clamp(4rem, 14vw, 6.4rem); }
    .atlas-meta { grid-template-columns: repeat(2, 1fr); }
    .atlas-meta div:nth-child(even) { padding-left: 16px; border-left: 1px solid rgba(251, 247, 238, 0.14); }
    .atlas-meta div:nth-child(n+3) { margin-top: 12px; }
    .story-heading h2 { max-width: 100%; }
    .story-side__intro { display: block; }
    .story-side__intro p { margin-top: 8px; }
    .field-intro { grid-template-columns: 1fr; gap: 18px; }
    .field-index__row { grid-template-columns: 38px minmax(0, 1fr) 22px; gap: 14px; padding-block: 18px; }
    .field-index__desc { grid-column: 2 / 4; }
    .field-index__arrow { display: none; }
    .latest-grid { grid-template-columns: 1fr 1fr; }
    .latest-grid > :global(.article-card:first-child) { grid-column: 1 / -1; min-height: 0; }
    .latest-grid > :global(.article-card:first-child .card-media) { min-height: 300px; }
  }

  @media (max-width: 560px) {
    .atlas-hero { padding-top: 34px; border-radius: 0 0 26px 26px; }
    .atlas-heading h1 { font-size: clamp(3.6rem, 17vw, 5.2rem); }
    .atlas-deck p { font-size: 0.91rem; }
    .atlas-actions { align-items: stretch; }
    .atlas-actions .btn { width: 100%; }
    .atlas-text-link { justify-self: start; }
    .atlas-meta { margin-top: 20px; }
    .atlas-meta div { display: block; padding-top: 13px; }
    .atlas-meta strong { display: block; font-size: 1.32rem; }
    .atlas-meta span { display: block; margin-top: 2px; }
    .story-section { padding-bottom: 76px; }
    .story-lead { min-height: 520px; }
    .story-lead__copy { padding: 24px; }
    .story-lead h3 { font-size: 2.5rem; }
    .story-lead p { font-size: 0.82rem; }
    .story-row { grid-template-columns: 24px 78px minmax(0, 1fr); gap: 12px; }
    .story-row img { width: 78px; height: 92px; }
    .story-row__copy strong { font-size: 1.25rem; }
    .story-row__copy > span { display: none; }
    .story-row__arrow { display: none; }
    .field-section { padding-block: 76px; }
    .field-index__title strong { font-size: 1.28rem; }
    .field-index__desc { font-size: 0.69rem; }
    .latest-section { padding-block: 78px; }
    .latest-grid { grid-template-columns: 1fr; }
    .latest-grid > :global(.article-card:first-child) { grid-column: auto; }
    .phrase-section { padding-block: 68px 84px; }
  }
</style>
