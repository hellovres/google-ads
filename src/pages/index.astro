---
import BaseLayout from '../layouts/BaseLayout.astro';
import CityMap from '../components/CityMap.astro';
import { site } from '../lib/site';
import { places } from '../data/chongqing-places';

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
  inLanguage: 'en',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${site.url}/search/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  email: site.email,
  description: site.description,
};
const attractionListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Attractions across Chongqing',
  numberOfItems: places.length,
  itemListElement: places.map((place, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'TouristAttraction',
      name: place.name,
      alternateName: place.zh,
      description: place.note,
      ...(place.href ? { url: new URL(place.href, site.url).toString() } : {}),
      address: {
        '@type': 'PostalAddress',
        addressLocality: place.area,
        addressRegion: 'Chongqing',
        addressCountry: 'CN',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: place.coordinates[1],
        longitude: place.coordinates[0],
      },
    },
  })),
};

---

<BaseLayout
  title={site.name}
  description={site.description}
  image="/images/og-cover.svg"
  showFooter={false}
  preconnectMap
  jsonLd={[websiteJsonLd, organizationJsonLd, attractionListJsonLd]}
>
  <CityMap />
</BaseLayout>

<style>
  :global(body) { background: #dfe5df; }
</style>
