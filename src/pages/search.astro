---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search Chongqing Field Guide for attractions, food, itineraries and practical travel advice." noindex>
  <article class="content-page">
    <div class="wrap">
      <span class="eyebrow" style="color: var(--terra);">Search</span>
      <h1 class="display">Find the next answer.</h1>
      <p class="intro">Search across first-time planning, attractions, food, day trips, transport and the practical details that make the trip run smoothly.</p>

      <form class="search-box" role="search" id="search-form">
        <label class="sr-only" for="search-input">Search guides</label>
        <input id="search-input" name="q" type="search" placeholder="Try Liziba, hotpot, visa or Wulong" autocomplete="off" />
        <button class="btn" type="submit">Search</button>
      </form>
      <p class="search-status" id="search-status" aria-live="polite">Loading the guide index…</p>
      <div class="search-results" id="search-results"></div>
    </div>
  </article>
</BaseLayout>

<script is:inline>
  const form = document.getElementById('search-form');
  const input = document.getElementById('search-input');
  const status = document.getElementById('search-status');
  const results = document.getElementById('search-results');
  let index = [];

  const normalise = (value) => value.toLowerCase().normalize('NFKD');

  function render(items, query) {
    results.replaceChildren();
    if (!query) {
      status.textContent = 'Type a place, dish or practical question.';
      return;
    }
    status.textContent = items.length
      ? items.length + (items.length === 1 ? ' guide found' : ' guides found')
      : 'No guides matched that search. Try a shorter phrase.';
    for (const item of items) {
      const link = document.createElement('a');
      link.className = 'search-result';
      link.href = item.url;
      const title = document.createElement('strong');
      title.textContent = item.title;
      const meta = document.createElement('span');
      meta.textContent = item.categoryName + ' · ' + item.description;
      link.append(title, meta);
      results.append(link);
    }
  }

  function search(query) {
    const words = normalise(query.trim()).split(/\s+/).filter(Boolean);
    if (!words.length) return render([], '');
    const matches = index
      .map((item) => {
        const haystack = normalise([item.title, item.description, item.categoryName, ...(item.keywords || [])].join(' '));
        const score = words.reduce((total, word) => total + (haystack.includes(word) ? (item.title.toLowerCase().includes(word) ? 3 : 1) : 0), 0);
        return { item, score };
      })
      .filter((entry) => entry.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 18)
      .map((entry) => entry.item);
    render(matches, query);
  }

  fetch('/search-index.json')
    .then((response) => response.json())
    .then((data) => {
      index = data;
      const query = new URLSearchParams(window.location.search).get('q') || '';
      input.value = query;
      search(query);
    })
    .catch(() => {
      status.textContent = 'The search index could not be loaded. Browse the guide sections from the menu.';
    });

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const query = input.value;
    const url = new URL(window.location.href);
    if (query.trim()) url.searchParams.set('q', query.trim());
    else url.searchParams.delete('q');
    history.replaceState({}, '', url);
    search(query);
  });

  let timer;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => search(input.value), 120);
  });
</script>
