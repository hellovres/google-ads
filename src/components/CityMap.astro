---
import 'maplibre-gl/dist/maplibre-gl.css';
import { featuredPlaces, placeCategories, placeCollection, places } from '../data/chongqing-places';

const placeCount = places.length;
---

<section class="map-home" aria-labelledby="map-home-title">
  <div id="chongqing-map" class="map-canvas" role="region" aria-label="Interactive map of attractions across Chongqing"></div>

  <h1 id="map-home-title" class="sr-only">Read all of Chongqing.</h1>

  <div class="map-views" role="group" aria-label="Map views">
    <button class="is-active" type="button" data-map-view="province" aria-label="Whole city" aria-pressed="true" title="Whole city" disabled>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4.25 6.6 9.45 4.5l5.1 2.1 5.2-2v13.1l-5.2 2-5.1-2.1-5.2 2.1V6.6Z"/>
        <path d="M9.45 4.5v13.1M14.55 6.6v13.1"/>
      </svg>
    </button>
    <button type="button" data-map-view="core" aria-label="City core" aria-pressed="false" title="City core" disabled>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="6.2"/>
        <circle cx="12" cy="12" r="2.15"/>
        <path d="M12 2.2v3.1M12 18.7v3.1M2.2 12h3.1M18.7 12h3.1"/>
      </svg>
    </button>
  </div>

  <div class="map-key" aria-label="Map legend">
    <span><i class="is-city"></i>City landmark</span>
    <span><i class="is-region"></i>Across Chongqing</span>
    <small>OpenFreeMap · map data © OpenStreetMap contributors</small>
  </div>

  <div class="map-loading" role="status"><span></span>Loading map</div>

  <noscript>
    <div class="map-noscript">The interactive map needs JavaScript. Use the guide links below.</div>
  </noscript>
</section>

<section class="home-directory" aria-labelledby="home-directory-title">
  <div class="home-directory__inner">
    <div class="home-directory__intro">
      <span class="directory-kicker">Start exploring</span>
      <h2 id="home-directory-title">Places and guides</h2>
    </div>

    <nav class="featured-links" aria-label="Featured attraction guides">
      {featuredPlaces.map((place) => (
        <a class="featured-link" href={place.href}>
          <strong>{place.linkLabel}</strong>
          <span>{place.area}</span>
        </a>
      ))}
    </nav>

    <nav class="category-links" aria-label="Guide categories">
      {placeCategories.map((category) => (
        <a href={category.href}>{category.label}</a>
      ))}
    </nav>
  </div>
</section>

<script type="application/json" id="chongqing-places" set:html={JSON.stringify(placeCollection)}></script>

<script>
  import maplibreWorkerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?url';

  const mapElement = document.getElementById('chongqing-map');
  const placesElement = document.getElementById('chongqing-places');
  const root = document.querySelector('.map-home');
  const loader = document.querySelector('.map-loading');
  let started = false;

  async function initializeMap() {
    if (started || !mapElement || !placesElement || !root) return;
    started = true;

    try {
      const maplibregl = await import('maplibre-gl');
      maplibregl.setWorkerUrl(maplibreWorkerUrl);

      const placeData = JSON.parse(placesElement.textContent || '{"type":"FeatureCollection","features":[]}');
      const provinceBounds = [[105.10, 28.12], [110.25, 32.28]];
      const map = new maplibregl.Map({
        container: mapElement,
        style: 'https://tiles.openfreemap.org/styles/liberty',
        bounds: provinceBounds,
        fitBoundsOptions: { padding: 36 },
        minZoom: 5.4,
        maxZoom: 15.5,
        attributionControl: false,
      });

      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
      map.addControl(new maplibregl.ScaleControl({ unit: 'metric', maxWidth: 110 }), 'bottom-right');

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isCompact = () => window.matchMedia('(max-width: 760px)').matches;

      function fitProvince(animate = true) {
        map.fitBounds(provinceBounds, {
          padding: isCompact()
            ? { top: 70, right: 20, bottom: 16, left: 20 }
            : { top: 68, right: 74, bottom: 42, left: 78 },
          duration: animate && !reduceMotion ? 850 : 0,
          maxZoom: 7.1,
        });
      }

      function fitCore() {
        map.jumpTo({
          center: [106.56, 29.56],
          zoom: 13.2,
          bearing: 0,
          pitch: 0,
        });
      }

      map.on('error', (event) => {
        console.warn('Map resource could not be loaded.', event.error);
      });

      map.on('load', async () => {
        if (map.getLayer('natural_earth')) map.setLayoutProperty('natural_earth', 'visibility', 'none');
        if (map.getLayer('background')) map.setPaintProperty('background', 'background-color', '#e7e7de');
        if (map.getLayer('water')) map.setPaintProperty('water', 'fill-color', '#a9c9c4');
        if (map.getLayer('park')) map.setPaintProperty('park', 'fill-color', '#cad8c8');

        try {
          const boundary = await fetch('/data/chongqing-boundary.geojson').then((response) => response.json());
          map.addSource('chongqing-boundary', { type: 'geojson', data: boundary });
          map.addLayer({
            id: 'chongqing-fill',
            type: 'fill',
            source: 'chongqing-boundary',
            paint: { 'fill-color': '#d6c6a6', 'fill-opacity': 0.10 },
          });
          map.addLayer({
            id: 'chongqing-outline',
            type: 'line',
            source: 'chongqing-boundary',
            paint: {
              'line-color': '#17352d',
              'line-width': ['interpolate', ['linear'], ['zoom'], 5, 1.1, 9, 2.4],
              'line-opacity': 0.9,
            },
          });
        } catch (error) {
          console.warn('Chongqing boundary could not be loaded.', error);
        }

        map.addSource('places', {
          type: 'geojson',
          data: placeData,
          cluster: true,
          clusterMaxZoom: 10,
          clusterRadius: 38,
        });

        map.addLayer({
          id: 'place-clusters',
          type: 'circle',
          source: 'places',
          filter: ['has', 'point_count'],
          paint: {
            'circle-color': '#cf4d2f',
            'circle-radius': ['step', ['get', 'point_count'], 20, 5, 24, 10, 28],
            'circle-stroke-color': '#fbf7ee',
            'circle-stroke-width': 3,
            'circle-opacity': 0.96,
          },
        });

        map.addLayer({
          id: 'place-cluster-count',
          type: 'symbol',
          source: 'places',
          filter: ['has', 'point_count'],
          layout: {
            'text-field': '{point_count_abbreviated}',
            'text-size': 13,
            'text-font': ['Noto Sans Regular'],
          },
          paint: { 'text-color': '#fffaf0' },
        });

        map.addLayer({
          id: 'place-points',
          type: 'circle',
          source: 'places',
          filter: ['!', ['has', 'point_count']],
          paint: {
            'circle-color': ['match', ['get', 'kind'], 'city', '#cf4d2f', '#276354'],
            'circle-radius': ['interpolate', ['linear'], ['zoom'], 6, 6.5, 10, 8.5, 14, 10],
            'circle-stroke-color': '#fffaf0',
            'circle-stroke-width': 2.5,
          },
        });

        const labelStyle = {
          'text-field': ['get', 'name'],
          'text-font': ['Noto Sans Regular'],
          'text-offset': [0, 1.35],
          'text-anchor': 'top',
          'text-allow-overlap': false,
          'text-ignore-placement': false,
        };

        map.addLayer({
          id: 'place-labels-region',
          type: 'symbol',
          source: 'places',
          filter: ['all', ['!', ['has', 'point_count']], ['==', ['get', 'kind'], 'region']],
          minzoom: 6.2,
          layout: { ...labelStyle, 'text-size': 12 },
          paint: {
            'text-color': '#17352d',
            'text-halo-color': 'rgba(251, 247, 238, 0.95)',
            'text-halo-width': 1.7,
          },
        });

        map.addLayer({
          id: 'place-labels-city',
          type: 'symbol',
          source: 'places',
          filter: ['all', ['!', ['has', 'point_count']], ['==', ['get', 'kind'], 'city']],
          minzoom: 9.2,
          layout: { ...labelStyle, 'text-size': 11 },
          paint: {
            'text-color': '#17352d',
            'text-halo-color': 'rgba(251, 247, 238, 0.95)',
            'text-halo-width': 1.7,
          },
        });

        map.on('click', 'place-clusters', (event) => {
          const feature = event.features?.[0];
          if (!feature) return;
          const clusterId = feature.properties?.cluster_id;
          map.getSource('places')?.getClusterExpansionZoom(clusterId).then((zoom) => {
            map.easeTo({
              center: feature.geometry.coordinates,
              zoom: zoom + 0.35,
              duration: reduceMotion ? 0 : 700,
            });
          });
        });

        map.on('click', 'place-points', (event) => {
          const feature = event.features?.[0];
          if (!feature) return;
          const place = feature.properties;
          const content = document.createElement('div');
          content.className = 'place-popup';

          const area = document.createElement('span');
          area.className = 'place-popup__area';
          area.textContent = place.area;

          const title = document.createElement('strong');
          title.textContent = place.name;

          const localName = document.createElement('span');
          localName.className = 'place-popup__local';
          localName.lang = 'zh-CN';
          localName.textContent = place.zh;

          const note = document.createElement('p');
          note.textContent = place.note;

          content.append(area, title, localName, note);

          if (place.href) {
            const link = document.createElement('a');
            link.href = place.href;
            link.textContent = 'Open the field guide';
            content.append(link);
          }

          new maplibregl.Popup({ offset: 13, maxWidth: '290px' })
            .setLngLat(feature.geometry.coordinates)
            .setDOMContent(content)
            .addTo(map);
        });

        ['place-clusters', 'place-points'].forEach((layer) => {
          map.on('mouseenter', layer, () => { map.getCanvas().style.cursor = 'pointer'; });
          map.on('mouseleave', layer, () => { map.getCanvas().style.cursor = ''; });
        });

        document.querySelectorAll('[data-map-view]').forEach((button) => {
          button.addEventListener('click', () => {
            document.querySelectorAll('[data-map-view]').forEach((item) => {
              item.classList.remove('is-active');
              item.setAttribute('aria-pressed', 'false');
            });
            button.classList.add('is-active');
            button.setAttribute('aria-pressed', 'true');
            if (button.dataset.mapView === 'core') fitCore();
            else fitProvince();
          });
        });

        fitProvince(false);
        document.querySelectorAll('[data-map-view]').forEach((button) => { button.disabled = false; });
        root.classList.add('is-ready');
      });
    } catch (error) {
      console.error('The map could not be initialized.', error);
      if (loader) {
        loader.classList.add('has-error');
        loader.textContent = 'Map unavailable · use the guide links below';
      }
    }
  }

  function scheduleMap() {
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(() => { void initializeMap(); }, { timeout: 1200 });
    } else {
      window.setTimeout(() => { void initializeMap(); }, 200);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleMap, { once: true });
  } else {
    scheduleMap();
  }
</script>

<style>
  .map-home {
    position: relative;
    height: clamp(520px, calc(100svh - 210px), 780px);
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(ellipse at 25% 30%, rgba(255, 250, 240, 0.85), transparent 38%),
      repeating-radial-gradient(ellipse at 72% 42%, transparent 0 34px, rgba(39, 99, 84, 0.11) 35px 36px, transparent 37px 68px),
      #dfe5df;
  }

  .map-canvas {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(23, 53, 45, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(23, 53, 45, 0.035) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .map-views {
    position: absolute;
    z-index: 5;
    top: 20px;
    left: clamp(18px, 3vw, 46px);
    display: inline-flex;
    gap: 3px;
    padding: 4px;
    border: 1px solid rgba(21, 35, 29, 0.17);
    border-radius: 13px;
    background: rgba(251, 247, 238, 0.94);
    box-shadow: 0 12px 34px rgba(21, 35, 29, 0.17);
    backdrop-filter: blur(14px);
  }

  .map-views button {
    display: grid;
    width: 36px;
    height: 36px;
    padding: 0;
    place-items: center;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .map-views button:hover {
    background: rgba(23, 53, 45, 0.09);
    color: var(--ink);
  }

  .map-views button:focus-visible {
    outline: 2px solid var(--terra);
    outline-offset: 2px;
  }

  .map-views button.is-active {
    background: var(--ink);
    color: var(--cream);
  }

  .map-views button:active { transform: scale(0.94); }
  .map-views button:disabled { cursor: wait; opacity: 0.58; }

  .map-views svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .directory-kicker {
    color: var(--terra);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .map-key {
    position: absolute;
    z-index: 4;
    bottom: 14px;
    left: clamp(18px, 3vw, 46px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px 15px;
    max-width: calc(100% - 130px);
    padding: 9px 12px;
    border: 1px solid rgba(21, 35, 29, 0.14);
    border-radius: 10px;
    background: rgba(251, 247, 238, 0.91);
    color: var(--muted);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .map-key span { display: inline-flex; align-items: center; gap: 6px; }
  .map-key i { width: 9px; height: 9px; border-radius: 50%; }
  .map-key .is-city { background: var(--terra); }
  .map-key .is-region { background: var(--jade); }
  .map-key small { flex-basis: 100%; color: #64746d; font-size: 0.52rem; font-weight: 500; letter-spacing: 0.015em; }

  .map-loading {
    position: absolute;
    z-index: 5;
    top: 80px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border: 1px solid rgba(21, 35, 29, 0.14);
    border-radius: 999px;
    background: rgba(251, 247, 238, 0.92);
    color: var(--muted);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: opacity 240ms ease, visibility 240ms ease;
  }
  .map-loading span {
    width: 12px;
    height: 12px;
    border: 1.5px solid rgba(21, 35, 29, 0.2);
    border-top-color: var(--terra);
    border-radius: 50%;
    animation: map-spin 800ms linear infinite;
  }
  .map-loading.has-error { max-width: 240px; line-height: 1.35; text-transform: none; }
  .map-loading.has-error span { display: none; }
  .map-home.is-ready .map-loading { opacity: 0; visibility: hidden; }

  .map-noscript {
    position: absolute;
    z-index: 6;
    right: 16px;
    bottom: 16px;
    max-width: 300px;
    padding: 12px;
    border-radius: 10px;
    background: var(--cream);
    color: var(--muted);
    font-size: 0.75rem;
  }

  .map-home :global(.maplibregl-ctrl-group) { overflow: hidden; border-radius: 12px; box-shadow: 0 8px 24px rgba(21, 35, 29, 0.15); }
  .map-home :global(.maplibregl-ctrl-group button) { background: rgba(251, 247, 238, 0.95); }
  .map-home :global(.maplibregl-ctrl-scale) { border-color: rgba(21, 35, 29, 0.55); background: rgba(251, 247, 238, 0.8); color: var(--ink); }
  .map-home :global(.maplibregl-popup-content) { padding: 18px 19px; border-radius: 14px; box-shadow: 0 18px 50px rgba(21, 35, 29, 0.25); }
  .map-home :global(.place-popup) { display: grid; gap: 5px; }
  .map-home :global(.place-popup__area),
  .map-home :global(.place-popup__local) { color: var(--muted); font-size: 0.62rem; }
  .map-home :global(.place-popup__area) { color: var(--terra); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .map-home :global(.place-popup strong) { font-family: var(--serif); font-size: 1.35rem; font-weight: 400; line-height: 1.05; }
  .map-home :global(.place-popup p) { margin: 3px 0 5px; color: var(--muted); font-size: 0.73rem; line-height: 1.45; }
  .map-home :global(.place-popup a) { color: var(--terra); font-size: 0.7rem; font-weight: 700; text-decoration: none; }

  .home-directory {
    border-top: 1px solid var(--line-strong);
    background: var(--paper);
  }

  .home-directory__inner {
    width: min(calc(100% - 36px), var(--wrap));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr) 145px;
    gap: 28px;
    padding-block: 20px 22px;
  }

  .home-directory__intro h2 {
    margin-top: 7px;
    font-family: var(--serif);
    font-size: 1.75rem;
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .featured-links {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 18px;
    border-top: 1px solid var(--line);
  }

  .featured-link {
    display: grid;
    align-content: start;
    min-width: 0;
    padding: 11px 0 10px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .featured-link strong {
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .featured-link span {
    margin-top: 4px;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .featured-link:hover strong { color: var(--terra); }

  .category-links {
    display: grid;
    align-content: start;
    gap: 7px;
    padding-top: 10px;
  }

  .category-links a {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 650;
    text-decoration: none;
  }

  .category-links a:hover { color: var(--terra); }

  @keyframes map-spin { to { transform: rotate(360deg); } }

  @media (max-width: 1060px) {
    .home-directory__inner { grid-template-columns: 150px minmax(0, 1fr); gap: 20px; }
    .featured-links { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .category-links { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px 18px; padding-top: 0; border-top: 1px solid var(--line); }
  }

  @media (max-width: 760px) {
    .map-home { height: clamp(500px, calc(100svh - 190px), 720px); }
    .map-views { top: 14px; left: 14px; }
    .map-views button { width: 34px; height: 34px; }
    .map-key { bottom: 12px; left: 14px; max-width: calc(100% - 92px); }
    .map-key small { display: none; }
    .map-loading { top: 76px; }
    .home-directory__inner { width: calc(100% - 28px); grid-template-columns: 1fr; gap: 12px; padding-block: 16px 18px; }
    .home-directory__intro { display: flex; align-items: end; justify-content: space-between; gap: 12px; }
    .home-directory__intro h2 { margin-top: 0; font-size: 1.55rem; }
    .featured-links { grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 0; }
    .featured-link { padding-block: 9px 8px; border-top: 1px solid var(--line); }
    .category-links { padding-top: 4px; border-top: 0; gap: 7px 14px; }
  }

  @media (max-width: 480px) {
    .featured-link span { display: none; }
  }
</style>
