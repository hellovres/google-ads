---
const routes = [
  {
    href: '/guides/first-time-chongqing-guide/',
    number: '01',
    label: 'Most useful first',
    title: 'First-time guide',
    description: 'What to expect, how the city works and where to begin.',
  },
  {
    href: '/attractions/hongyadong-night-crowds/',
    number: '02',
    label: 'After dark',
    title: 'Hongyadong, timed right',
    description: 'The view worth waiting for, and where to stand when it is packed.',
  },
  {
    href: '/attractions/yangtze-river-cableway-queue/',
    number: '03',
    label: 'Cross the water',
    title: 'The cableway',
    description: 'Tickets, queue strategy and the better side to start from.',
  },
];
---

<div class="atlas-board">
  <section class="city-map" aria-labelledby="city-map-title">
    <header class="city-map__top">
      <div>
        <span class="map-overline"><i aria-hidden="true"></i>Central Chongqing</span>
        <h2 id="city-map-title">The river bends</h2>
      </div>
      <span class="map-view">First-visit map · 08 places</span>
    </header>

    <div class="map-stage">
      <svg class="map-art" viewBox="0 0 960 690" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="map-paper" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#f6f0e4"></stop>
            <stop offset="1" stop-color="#e8decc"></stop>
          </linearGradient>
          <linearGradient id="river-band" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#b8d1ca"></stop>
            <stop offset="1" stop-color="#86b2ad"></stop>
          </linearGradient>
          <pattern id="map-grid" width="32" height="32" patternUnits="userSpaceOnUse">
            <circle cx="1" cy="1" r="0.8" fill="#173229" opacity="0.16"></circle>
          </pattern>
          <filter id="water-soften" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="1.5"></feGaussianBlur>
          </filter>
          <path id="jialing-line" d="M -30 85 C 90 158 168 121 254 165 C 330 204 355 260 445 302 C 525 338 575 352 632 344 C 676 338 696 370 707 424"></path>
          <path id="yangtze-line" d="M -35 644 C 90 610 142 543 214 515 C 286 486 323 444 408 430 C 500 414 559 455 641 436 C 729 415 806 357 991 330"></path>
        </defs>

        <rect width="960" height="690" fill="url(#map-paper)"></rect>
        <rect width="960" height="690" fill="url(#map-grid)"></rect>

        <g class="topography" fill="none" stroke="#968f7e" stroke-width="1.05" opacity="0.34">
          <path d="M-40 185 C65 130 116 144 188 93 C238 56 288 26 365 33"></path>
          <path d="M-18 205 C84 154 138 167 207 116 C261 78 304 50 375 57"></path>
          <path d="M-7 226 C95 176 151 190 222 138 C276 101 323 76 389 82"></path>
          <path d="M-25 251 C85 203 154 214 234 163 C298 121 345 105 414 111"></path>
          <path d="M-39 275 C82 229 164 243 254 192 C329 150 372 135 438 142"></path>
          <path d="M12 333 C103 293 160 303 241 261 C318 222 380 214 441 222"></path>
          <path d="M50 560 C83 521 124 502 182 503 C239 503 268 475 302 453"></path>
          <path d="M52 592 C99 548 145 530 202 532 C256 534 288 509 326 483"></path>
          <path d="M61 623 C119 582 167 566 226 570 C287 574 322 550 362 520"></path>
          <path d="M78 657 C138 615 193 603 251 610 C316 619 355 595 403 560"></path>
          <path d="M568 602 C643 564 683 531 745 549 C804 566 846 532 914 498"></path>
          <path d="M574 633 C650 595 695 563 757 581 C814 598 865 559 933 526"></path>
          <path d="M611 671 C676 639 723 606 785 624 C842 640 898 607 968 558"></path>
        </g>

        <g class="rivers">
          <path d="M -30 85 C 90 158 168 121 254 165 C 330 204 355 260 445 302 C 525 338 575 352 632 344 C 676 338 696 370 707 424" fill="none" stroke="#d9e7e1" stroke-width="88" stroke-linecap="round" opacity="0.85"></path>
          <path d="M -30 85 C 90 158 168 121 254 165 C 330 204 355 260 445 302 C 525 338 575 352 632 344 C 676 338 696 370 707 424" fill="none" stroke="url(#river-band)" stroke-width="65" stroke-linecap="round"></path>
          <path d="M -30 85 C 90 158 168 121 254 165 C 330 204 355 260 445 302 C 525 338 575 352 632 344 C 676 338 696 370 707 424" fill="none" stroke="#eaf2ed" stroke-width="3" stroke-linecap="round" stroke-dasharray="1 18" opacity="0.9"></path>

          <path d="M -35 644 C 90 610 142 543 214 515 C 286 486 323 444 408 430 C 500 414 559 455 641 436 C 729 415 806 357 991 330" fill="none" stroke="#d9e7e1" stroke-width="116" stroke-linecap="round" opacity="0.85"></path>
          <path d="M -35 644 C 90 610 142 543 214 515 C 286 486 323 444 408 430 C 500 414 559 455 641 436 C 729 415 806 357 991 330" fill="none" stroke="url(#river-band)" stroke-width="90" stroke-linecap="round"></path>
          <path d="M -35 644 C 90 610 142 543 214 515 C 286 486 323 444 408 430 C 500 414 559 455 641 436 C 729 415 806 357 991 330" fill="none" stroke="#eaf2ed" stroke-width="3" stroke-linecap="round" stroke-dasharray="1 20" opacity="0.9"></path>
        </g>

        <g class="map-labels" fill="#355a4e" font-size="12" font-weight="700" letter-spacing="2.6">
          <text x="85" y="145" transform="rotate(20 85 145)">JIALING RIVER · 嘉陵江</text>
          <text x="270" y="598" transform="rotate(-9 270 598)">YANGTZE RIVER · 长江</text>
          <text x="324" y="495" fill="#67776f" font-size="15" letter-spacing="3.5">NAN'AN</text>
          <text x="424" y="373" fill="#67776f" font-size="15" letter-spacing="3.5">YUZHONG</text>
          <text x="215" y="233" fill="#67776f" font-size="13" letter-spacing="3.2">SHAPINGBA</text>
          <text x="724" y="264" fill="#67776f" font-size="13" letter-spacing="3.2">JIANGBEI</text>
        </g>

        <g class="streets" fill="none" stroke="#f8f2e6" stroke-width="5.2" opacity="0.9">
          <path d="M504 267 C573 290 609 330 694 351"></path>
          <path d="M542 399 C590 369 644 361 710 386"></path>
          <path d="M598 241 L548 456"></path>
          <path d="M658 252 L620 453"></path>
          <path d="M423 332 C482 348 542 326 626 359"></path>
          <path d="M436 378 C513 382 579 399 649 407"></path>
          <path d="M461 455 C521 427 594 431 681 463"></path>
        </g>
        <g class="streets" fill="none" stroke="#b8ad98" stroke-width="1.1" opacity="0.7">
          <path d="M504 267 C573 290 609 330 694 351"></path>
          <path d="M542 399 C590 369 644 361 710 386"></path>
          <path d="M598 241 L548 456"></path>
          <path d="M658 252 L620 453"></path>
          <path d="M423 332 C482 348 542 326 626 359"></path>
          <path d="M436 378 C513 382 579 399 649 407"></path>
          <path d="M461 455 C521 427 594 431 681 463"></path>
        </g>

        <g class="trails" fill="none" stroke="#c64f35" stroke-width="2" stroke-dasharray="4 9" stroke-linecap="round" opacity="0.7">
          <path d="M264 303 C311 321 352 354 398 381 C452 413 504 425 562 431 C615 437 659 450 716 437"></path>
          <path d="M264 303 C311 321 352 354 398 381 C452 413 504 425 562 431 C615 437 659 450 716 437"></path>
        </g>

        <g class="bridges" fill="none" stroke="#fffaf0" stroke-width="9" stroke-linecap="round">
          <path d="M746 316 L802 370"></path>
          <path d="M339 484 L323 548"></path>
          <path d="M568 444 L651 397"></path>
        </g>
        <g class="bridges" fill="none" stroke="#5c7067" stroke-width="1.5" stroke-linecap="round">
          <path d="M746 316 L802 370"></path>
          <path d="M339 484 L323 548"></path>
          <path d="M568 444 L651 397"></path>
        </g>

        <g class="metro-line" fill="none" stroke="#cf4d2f" stroke-width="3.2" stroke-linecap="round" opacity="0.88">
          <path d="M193 350 C301 330 381 370 475 371 C578 372 632 342 728 342 C805 342 849 365 918 354"></path>
        </g>
        <g class="metro-stops" fill="#f8f2e6" stroke="#cf4d2f" stroke-width="2">
          <circle cx="270" cy="347" r="5"></circle>
          <circle cx="398" cy="371" r="5"></circle>
          <circle cx="552" cy="358" r="5"></circle>
          <circle cx="653" cy="349" r="5"></circle>
          <circle cx="771" cy="342" r="5"></circle>
        </g>

        <g transform="translate(879 78)" fill="none" stroke="#415a50" stroke-width="1.2">
          <circle r="23" opacity="0.65"></circle>
          <path d="M0 -31 L5 -12 L0 -16 L-5 -12 Z" fill="#cf4d2f" stroke="none"></path>
          <path d="M0 17 L3 26 L0 23 L-3 26 Z" fill="#415a50" stroke="none"></path>
          <text x="0" y="-38" fill="#415a50" stroke="none" text-anchor="middle" font-size="9" font-weight="700" letter-spacing="1.5">N</text>
        </g>
        <g transform="translate(781 638)" fill="#415a50" font-size="10" letter-spacing="1.3">
          <text x="0" y="-14">SCHEMATIC SCALE</text>
          <path d="M0 0 H74" stroke="#415a50" stroke-width="1.4"></path>
          <path d="M0 -4 V4 M37 -4 V4 M74 -4 V4" stroke="#415a50" stroke-width="1.4"></path>
          <text x="0" y="18">0</text>
          <text x="31" y="18">1 KM</text>
        </g>
      </svg>

      <nav class="map-places" aria-label="Landmarks in central Chongqing">
        <a class="map-place place--ciqikou" href="/attractions/ciqikou-vs-longmenhao/" aria-label="Ciqikou old street, best in the morning">
          <span class="map-place__pin"><span>01</span></span>
          <span class="map-place__label"><strong>Ciqikou</strong><small>Old lanes · morning</small></span>
        </a>
        <a class="map-place place--liziba" href="/attractions/liziba-monorail-viewpoints/" aria-label="Liziba monorail viewpoints, early light">
          <span class="map-place__pin"><span>02</span></span>
          <span class="map-place__label"><strong>Liziba</strong><small>Monorail · early</small></span>
        </a>
        <a class="map-place place--kuixinglou" href="/attractions/kuixinglou-22-story-drop/" aria-label="Kuixinglou and the 22-story drop">
          <span class="map-place__pin"><span>03</span></span>
          <span class="map-place__label"><strong>Kuixinglou</strong><small>Vertical city</small></span>
        </a>
        <a class="map-place place--jiefangbei" href="/guides/where-to-stay-chongqing/" aria-label="Where to stay around Jiefangbei">
          <span class="map-place__pin"><span>04</span></span>
          <span class="map-place__label"><strong>Jiefangbei</strong><small>Stay &amp; eat</small></span>
        </a>
        <a class="map-place place--hongyadong" href="/attractions/hongyadong-night-crowds/" aria-label="Hongyadong at night">
          <span class="map-place__pin"><span>05</span></span>
          <span class="map-place__label"><strong>Hongyadong</strong><small>After dark</small></span>
        </a>
        <a class="map-place place--cableway" href="/attractions/yangtze-river-cableway-queue/" aria-label="Yangtze River Cableway queue strategy">
          <span class="map-place__pin"><span>06</span></span>
          <span class="map-place__label"><strong>Ropeway</strong><small>Cross the river</small></span>
        </a>
        <a class="map-place place--shibati" href="/attractions/shibati-mountain-trails/" aria-label="Shibati mountain stairs">
          <span class="map-place__pin"><span>07</span></span>
          <span class="map-place__label"><strong>Shibati</strong><small>Stairs &amp; lanes</small></span>
        </a>
        <a class="map-place place--eling" href="/attractions/eling-park-nanbin-road/" aria-label="Eling Park and Nanbin Road viewpoints">
          <span class="map-place__pin"><span>08</span></span>
          <span class="map-place__label"><strong>Eling Park</strong><small>City panorama</small></span>
        </a>
      </nav>

      <div class="map-coordinate" aria-hidden="true">
        <span>29.5630° N</span>
        <span>106.5516° E</span>
      </div>
    </div>

    <footer class="city-map__foot">
      <div class="map-legend" aria-label="Map legend">
        <span><i class="legend-river"></i>River</span>
        <span><i class="legend-metro"></i>Metro</span>
        <span><i class="legend-walk"></i>Walking loop</span>
      </div>
      <p>Schematic map · not for turn-by-turn navigation</p>
    </footer>
  </section>

  <aside class="map-rail" aria-label="Choose a way into the map">
    <div class="map-rail__intro">
      <span class="map-rail__eyebrow">Pick your first thread</span>
      <h2>Start where the rivers meet.</h2>
      <p>Chongqing is easiest to decode in short, vertical loops. Follow one line now, then let the rest of the map unfold.</p>
    </div>

    <div class="map-rail__routes">
      {routes.map((route) => (
        <a class="map-route" href={route.href}>
          <span class="map-route__number">{route.number}</span>
          <span class="map-route__copy">
            <small>{route.label}</small>
            <strong>{route.title}</strong>
            <span>{route.description}</span>
          </span>
          <span class="map-route__arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>

    <a class="map-rail__all" href="/attractions/">
      Open the full attraction index
      <span aria-hidden="true">→</span>
    </a>
  </aside>
</div>

<style>
  .atlas-board {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 336px;
    gap: 18px;
    align-items: stretch;
  }

  .city-map {
    overflow: hidden;
    min-width: 0;
    border: 1px solid rgba(251, 247, 238, 0.26);
    border-radius: 24px;
    background: #ede4d4;
    color: var(--ink);
    box-shadow: 0 34px 80px rgba(5, 13, 10, 0.26);
  }

  .city-map__top,
  .city-map__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 18px 22px;
    background: rgba(251, 247, 238, 0.88);
  }

  .city-map__top {
    border-bottom: 1px solid rgba(21, 35, 29, 0.13);
  }

  .map-overline {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .map-overline i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--terra);
    box-shadow: 0 0 0 4px rgba(207, 77, 47, 0.13);
  }

  .city-map__top h2 {
    margin-top: 3px;
    font-family: var(--serif);
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .map-view {
    color: var(--muted);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-align: right;
    text-transform: uppercase;
  }

  .map-stage {
    position: relative;
    aspect-ratio: 1.35 / 1;
    isolation: isolate;
    overflow: hidden;
    background: #eee5d5;
  }

  .map-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .city-map__top h2,
  .map-view,
  .map-legend,
  .city-map__foot p {
    position: relative;
    z-index: 2;
  }

  .map-places {
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  .map-place {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--ink);
    text-decoration: none;
    transform: translate(-50%, -50%);
  }

  .map-place__pin {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    border: 2px solid #fbf7ee;
    border-radius: 50% 50% 50% 0;
    background: var(--terra);
    box-shadow: 0 4px 14px rgba(21, 35, 29, 0.25);
    color: var(--white);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    transform: rotate(-45deg);
    transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .map-place__pin span {
    transform: rotate(45deg);
  }

  .map-place__label {
    display: grid;
    min-width: max-content;
    padding: 6px 9px 7px;
    border: 1px solid rgba(21, 35, 29, 0.15);
    border-radius: 8px;
    background: rgba(251, 247, 238, 0.93);
    box-shadow: 0 7px 20px rgba(21, 35, 29, 0.09);
    line-height: 1.1;
    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
  }

  .map-place__label strong {
    font-size: 0.69rem;
    letter-spacing: 0.01em;
  }

  .map-place__label small {
    margin-top: 2px;
    color: var(--muted);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .map-place:hover .map-place__pin,
  .map-place:focus-visible .map-place__pin {
    background: var(--ink);
    box-shadow: 0 6px 18px rgba(21, 35, 29, 0.34);
    transform: rotate(-45deg) scale(1.12);
  }

  .map-place:hover .map-place__label,
  .map-place:focus-visible .map-place__label {
    border-color: var(--gold);
    background: var(--cream);
    transform: translateY(-2px);
  }

  .place--ciqikou { left: 25%; top: 42%; }
  .place--liziba { left: 41.5%; top: 53.7%; }
  .place--kuixinglou { left: 56%; top: 48.5%; }
  .place--jiefangbei { left: 66.7%; top: 53.2%; }
  .place--jiefangbei .map-place__label { margin-left: 2px; }
  .place--hongyadong { left: 71.2%; top: 62%; }
  .place--cableway { left: 82.2%; top: 60.5%; }
  .place--shibati { left: 64.3%; top: 67.5%; }
  .place--eling { left: 49.7%; top: 76.1%; }

  .place--hongyadong,
  .place--cableway,
  .place--eling {
    flex-direction: row-reverse;
  }

  .place--hongyadong .map-place__label,
  .place--cableway .map-place__label,
  .place--eling .map-place__label {
    text-align: right;
  }

  .map-coordinate {
    position: absolute;
    top: 19px;
    left: 20px;
    display: grid;
    gap: 1px;
    color: rgba(21, 35, 29, 0.46);
    font-size: 0.51rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .city-map__foot {
    padding-block: 13px;
    border-top: 1px solid rgba(21, 35, 29, 0.13);
  }

  .map-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    color: var(--muted);
    font-size: 0.61rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .map-legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .map-legend i {
    display: inline-block;
    width: 18px;
    height: 3px;
    background: var(--terra);
  }

  .map-legend .legend-river {
    height: 5px;
    border-radius: 999px;
    background: #8bb3ae;
  }

  .map-legend .legend-metro {
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--terra) 0 4px, transparent 4px 7px);
  }

  .map-legend .legend-walk {
    height: 2px;
    background: repeating-linear-gradient(90deg, #8d4f39 0 3px, transparent 3px 6px);
  }

  .city-map__foot p {
    color: var(--muted);
    font-size: 0.58rem;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .map-rail {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 28px 24px 24px;
    border: 1px solid rgba(251, 247, 238, 0.18);
    border-radius: 24px;
    background: rgba(251, 247, 238, 0.055);
  }

  .map-rail__eyebrow {
    color: var(--gold);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .map-rail__intro h2 {
    max-width: 260px;
    margin-top: 10px;
    font-family: var(--serif);
    font-size: 2.15rem;
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .map-rail__intro p {
    margin-top: 14px;
    color: rgba(251, 247, 238, 0.64);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .map-rail__routes {
    display: grid;
    border-top: 1px solid rgba(251, 247, 238, 0.17);
  }

  .map-route {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr) 18px;
    gap: 10px;
    align-items: start;
    padding: 15px 0;
    border-bottom: 1px solid rgba(251, 247, 238, 0.17);
    color: var(--cream);
    text-decoration: none;
  }

  .map-route__number {
    padding-top: 1px;
    color: var(--gold);
    font-family: var(--serif);
    font-size: 0.92rem;
  }

  .map-route__copy {
    display: grid;
  }

  .map-route__copy small {
    color: rgba(251, 247, 238, 0.43);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.105em;
    text-transform: uppercase;
  }

  .map-route__copy strong {
    margin-top: 3px;
    font-family: var(--serif);
    font-size: 1.18rem;
    font-weight: 400;
    line-height: 1.08;
  }

  .map-route__copy > span {
    margin-top: 5px;
    color: rgba(251, 247, 238, 0.56);
    font-size: 0.7rem;
    line-height: 1.45;
  }

  .map-route__arrow {
    color: var(--gold);
    transition: transform 180ms ease;
  }

  .map-route:hover .map-route__arrow {
    transform: translate(2px, -2px);
  }

  .map-route:hover .map-route__copy strong {
    color: var(--gold);
  }

  .map-rail__all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding: 12px 14px;
    border: 1px solid rgba(251, 247, 238, 0.23);
    border-radius: 999px;
    color: var(--cream);
    font-size: 0.72rem;
    font-weight: 700;
    text-decoration: none;
  }

  .map-rail__all:hover {
    border-color: var(--gold);
